# P0는 실제 키 없이 실행할 수 있습니다. 실제 비밀값을 이 파일에 넣지 마세요.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용: 파일 처리/계정 삭제 단계부터 사용합니다.
SUPABASE_SECRET_KEY=

# 명시적으로 켠 development 환경에서만 샘플을 표시합니다.
# 예: DEMO_MODE=true npm run dev
# production에서 true면 build/start가 실패합니다.
DEMO_MODE=false

# P6까지 false만 허용합니다.
FEATURE_AFFILIATE_LINKS=false
FEATURE_SPONSORED_CHALLENGES=false

NEXT_TELEMETRY_DISABLED=1
