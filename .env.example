# 실제 값은 .env.local에만 설정하세요. 이 예제에는 키를 넣지 마세요.
# P1/P2는 기존 개발용 Supabase URL과 publishable(또는 legacy anon) 키를 사용합니다.
# Dashboard의 Site URL / Redirect URLs / 이메일 템플릿도 docs/04를 따라 설정하세요.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# P2 사진 서명/검증 전용 서버 키. 브라우저/NEXT_PUBLIC 변수에 넣지 마세요.
# 아직 미설정이어도 텍스트 초안 저장은 가능하며 사진 업로드는 비활성화됩니다.
SUPABASE_SECRET_KEY=

# 명시적으로 켠 development 환경에서만 샘플을 표시합니다.
# 예: DEMO_MODE=true npm run dev
# production에서 true면 build/start가 실패합니다.
DEMO_MODE=false

# P6까지 false만 허용합니다.
FEATURE_AFFILIATE_LINKS=false
FEATURE_SPONSORED_CHALLENGES=false

NEXT_TELEMETRY_DISABLED=1
